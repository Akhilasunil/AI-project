PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/company-ai

# At least 16 characters. The API refuses to start with a shorter value.
JWT_SECRET=replace-me
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173

# Development-only seed accounts. Change these before any shared deployment.
# The seed script is refused when NODE_ENV=production unless SEED_ALLOW=true.
ADMIN_NAME=Company Admin
ADMIN_EMAIL=admin@company.test
ADMIN_PASSWORD=DevAdmin-12345

# Optional. Omit SEED_EMPLOYEE_EMAIL to seed only the administrator.
SEED_EMPLOYEE_NAME=Alex Morgan
SEED_EMPLOYEE_EMAIL=employee@company.test
SEED_EMPLOYEE_PASSWORD=DevEmployee-12345
SEED_EMPLOYEE_TEAM=People Operations
SEED_EMPLOYEE_SKILLS=Onboarding,HR Policy

# mock answers from uploaded document text and saved learning-resource details.
# Set AI_PROVIDER=openai and OPENAI_API_KEY to call OpenAI instead.
# Leave AI_PROVIDER=mock to run without an API key.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
